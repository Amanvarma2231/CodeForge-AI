# ── CodeForge AI Studio — API Keys Configuration ──────────────────────────
# Copy this file to .env and fill in your actual API keys.
# The app auto-loads .env on startup. Without keys, it runs in DEMO mode.
#
# ⭐ RECOMMENDED: Google Gemini (FREE tier available)
#    Get your free key at: https://aistudio.google.com/app/apikey

# Google Gemini 2.0 Flash (FREE, powerful, answers any question + code + images)
GEMINI_API_KEY=your_gemini_api_key_here

# Sarvam AI  → https://dashboard.sarvam.ai
SARVAM_API_KEY=your_sarvam_api_key_here

# NVIDIA Nemotron  → https://build.nvidia.com
NVIDIA_API_KEY=your_nvidia_api_key_here

# Bonsai AI  → https://bonsai.ai
BONSAI_API_KEY=your_bonsai_api_key_here

# Flask server settings
FLASK_SECRET_KEY=change-me-in-production-use-random-string
FLASK_DEBUG=true
PORT=5000
